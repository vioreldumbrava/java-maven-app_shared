# Copy to jenkins/.env and fill in. (.env is git-ignored)
REPO_URL=https://github.com/<your-user>/java-maven-app.git
REPO_BRANCH=master
JENKINS_URL=http://localhost:8080/
JENKINS_ADMIN_ID=admin
DOCKER_HUB_USER=
GITLAB_USER=
# Repo and branch of the django-app job
DJANGO_REPO_URL=https://github.com/<your-user>/java-maven-app_shared.git
DJANGO_BRANCH=django-app

# Only used by run.sh (plain docker, no compose)
CONTAINER_NAME=jenkins-casc
JENKINS_PORT=8090
JENKINS_VOLUME=jenkins_casc_home
# 1 = mount the host Docker socket (needed for docker build/push/run in pipelines)
DOCKER_SOCKET=0
